# Python, Jupyter, OS
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
*.db

# Secrets: tokens live in Colab secrets or your shell, never in the repo
.env*

# Large score/logit CSVs (>100MB, over GitHub's file limit) are tracked only as
# gzipped copies (<model>.csv.gz). The generator scripts write the plain .csv as
# their working checkpoint and a fresh .csv.gz when a model finishes; the
# analyses read whichever is newer (core/paths.py: scores_csv).
data/persona_reward_model_scores/*.csv
data/persona_reward_model_scores_kv_cached/*.csv
data/persona_base_model_logits/*.csv

# Scratch config the Colab runner writes for itself
config/gemma_base_models_no27b.yaml

# Local, timestamped analysis backups
persona/backups/
