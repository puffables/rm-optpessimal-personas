__pycache__/
*.pyc
.DS_Store
*.db
.ipynb_checkpoints/
.env*

# Large CSVs are too big for GitHub's 100MB limit; only the split parts
# under data/persona_reward_model_scores/parts/ are tracked. The full file
# is reconstructed locally by data/persona_reward_model_scores/reassemble.py
data/persona_reward_model_scores/*.csv

# Persona base-model logits also exceed the 100MB limit; regenerate locally
# with generate_persona_base_model_logprobs.py
data/persona_base_model_logits/*.csv

# Local, timestamped analysis backups — not part of the repo
persona_analysis/backup_*/

# KV-cached persona reward-model scores are too large for git (~321MB);
# regenerate locally with generate_persona_reward_model_scores.py
data/persona_reward_model_scores_kv_cached/
mfd_analysis/output/
